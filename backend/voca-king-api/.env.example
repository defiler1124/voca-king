# ==============================================================================
# VOCA KING 백엔드 환경변수 (예시)
# ==============================================================================
# 이 파일을 참고하여 운영 환경 변수를 설정하세요

# Spring 프로파일 (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# 데이터베이스 설정 (운영용)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vocaking?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=vocaking
SPRING_DATASOURCE_PASSWORD=vocaking123

# JWT 시크릿 키 (최소 256비트 = 32바이트 이상)
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-256-bits
